---
/**
 * AuroraBackground — High-Impact Luminous Ambient Mesh (Feature F11)
 *
 * Encapsulates the multi-ribbon OKLCH Aurora Background behind page content.
 * Styled via src/styles/aurora.css with GPU-accelerated drift animations
 * and theme-calibrated blend modes (screen in Dark Mode, multiply in Light Mode).
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`pointer-events-none fixed inset-0 -z-10 overflow-hidden ${className}`} aria-hidden="true">
  <div class="aurora-mesh"></div>
</div>
