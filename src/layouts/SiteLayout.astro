---
import '../styles/global.css';
import Header from '../features/navigation/Header.astro';
import Footer from '../features/navigation/Footer.astro';
import RevealOnView from '../shared/motion/RevealOnView.astro';
import AuroraBackground from '../shared/effects/AuroraBackground.astro';
import CorporateBackdrop from '../shared/effects/CorporateBackdrop.astro';
import LoadingShell from '../shared/loading/LoadingShell.astro';
import {
  PHOTO_MODULAR_CURVE_SET,
  PHOTO_NIGHT_GRID_SET,
  PHOTO_AMBER_LOUVERS_SET,
  type ResponsiveImageSet,
} from '../shared/media/frontImages';
import { withBase } from '../shared/routing/paths';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const {
  title,
  description,
  currentPath = Astro.url.pathname,
} = Astro.props;

// Determina a imagem LCP exata da rota atual para evitar preloads desnecessários
const cleanRoute = currentPath.replace(/^\/VOID-Business-Site-Template/, '').replace(/\/$/, '') || '/';
const lcpImageSet: ResponsiveImageSet | null =
  cleanRoute === '/'
    ? PHOTO_MODULAR_CURVE_SET
    : cleanRoute === '/sobre'
      ? PHOTO_AMBER_LOUVERS_SET
      : cleanRoute === '/produtos' || cleanRoute === '/servicos'
        ? PHOTO_NIGHT_GRID_SET
        : null;
const swUrl = withBase('/sw.js');
---

<!doctype html>
<html lang="pt-BR" data-theme="dark" class="dark" data-sw-url={swUrl}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07080c" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" />
    <link rel="shortcut icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <link rel="ard" href={withBase('/.well-known/ard.json')} />
    <link rel="describedby" type="text/plain" href={withBase('/llms.txt')} />
    {lcpImageSet && (
      <>
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={lcpImageSet.mobileAvif}
          media="(max-width: 767px)"
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={lcpImageSet.avif}
          media="(min-width: 768px)"
          fetchpriority="high"
        />
      </>
    )}
    <title>{title}</title>

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('void-business-theme');
          if (saved === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            document.documentElement.classList.remove('dark');
            return;
          }
          if (saved === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            document.documentElement.classList.add('dark');
            return;
          }
        } catch {
          // ignore storage errors
        }
        // Dark Mode (Obsidiana Frio oklch(11% 0.008 260)) é o padrão principal do sistema
        document.documentElement.setAttribute('data-theme', 'dark');
        document.documentElement.classList.add('dark');
      })();
      document.documentElement.classList.add('page-loading-enabled');
    </script>
  </head>
  <body class="min-h-screen bg-surface text-on-surface antialiased selection:bg-primary/25 selection:text-on-surface flex flex-col">
    <a href="#main-content" class="skip-link">
      Pular para o conteúdo principal
    </a>

    <!-- Barra fina de transição entre páginas em Laranja Sinalizador (oklch(68% 0.18 45)) -->
    <div
      id="page-transition-loader"
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-[100] flex flex-col justify-start"
    >
      <div class="h-[2px] w-full overflow-hidden bg-outline-variant/20">
        <div class="page-loader-bar h-full w-2/5 bg-primary"></div>
      </div>
    </div>

    <!-- Véu de Transição Cinemático MPA -->
    <div
      id="page-transition-veil"
      class="page-transition-veil pointer-events-none fixed inset-0 z-[90]"
      aria-hidden="true"
    ></div>

    <!-- Base Atmosférica & Átrio Desfocado com Fotografia Real -->
    <AuroraBackground />
    <CorporateBackdrop />

    <LoadingShell>
      <Header currentPath={currentPath} />

      <main id="main-content" tabindex="-1" class="flex-1">
        <slot />
      </main>

      <Footer />
    </LoadingShell>

    <RevealOnView />

    <script is:inline>
      (() => {
        const loader = document.getElementById('page-transition-loader');
        let navigationSafetyTimer = null;

        const hideLoader = () => {
          if (navigationSafetyTimer) {
            clearTimeout(navigationSafetyTimer);
            navigationSafetyTimer = null;
          }
          if (loader) loader.classList.remove('is-loading');
          document.documentElement.classList.remove('page-is-navigating');
        };

        window.addEventListener('pageshow', hideLoader);
        window.addEventListener('pagehide', hideLoader);
        window.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') hideLoader();
        });
        document.addEventListener('DOMContentLoaded', hideLoader);

        const triggerPageTransition = (target) => {
          if (!target || !(target instanceof Element)) return;
          const anchor = target.closest('a[href]');
          if (!anchor) return;
          const href = anchor.getAttribute('href') || '';
          if (!href.startsWith('/') || href.startsWith('/#') || anchor.hasAttribute('download') || anchor.getAttribute('target') === '_blank') return;

          try {
            const targetUrl = new URL(href, window.location.origin);
            if (targetUrl.pathname === window.location.pathname && (targetUrl.hash || !targetUrl.search)) return;
          } catch {
            return;
          }

          if (loader) {
            loader.classList.add('is-loading');
          }
          document.documentElement.classList.add('page-is-navigating');

          clearTimeout(navigationSafetyTimer);
          navigationSafetyTimer = setTimeout(hideLoader, 1200);
        };

        document.addEventListener('click', (event) => {
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const targetEl = event.target instanceof Element ? event.target : null;
          if (targetEl) {
            const radioBtn = targetEl.closest('[data-simulator-radio]');
            if (radioBtn) {
              const scenarioId = radioBtn.getAttribute('data-simulator-radio');
              const container = radioBtn.closest('[data-closing-simulator]');
              if (scenarioId && container) {
                container.querySelectorAll('[data-simulator-radio]').forEach((btn) => {
                  const active = btn.getAttribute('data-simulator-radio') === scenarioId;
                  btn.setAttribute('aria-checked', String(active));
                  btn.className = [
                    'rounded-full border px-3.5 py-1.5 text-xs sm:text-sm font-medium transition-colors cursor-pointer',
                    active
                      ? 'border-on-surface bg-on-surface text-background'
                      : 'border-outline-variant bg-transparent text-on-surface-variant hover:border-outline hover:text-on-surface',
                  ].join(' ');
                });
                container.querySelectorAll('[data-scenario-panel]').forEach((panel) => {
                  const active = panel.getAttribute('data-scenario-panel') === scenarioId;
                  panel.classList.toggle('hidden', !active);
                });
                return;
              }
            }
          }
          triggerPageTransition(event.target);
        });

        if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register(document.documentElement.dataset.swUrl || '/sw.js').catch(() => {});
          }, { once: true });
        }
      })();
    </script>
  </body>
</html>
